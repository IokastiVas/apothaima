---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import istoria from '../data/istoria.json';
import imgMegaro from '../assets/images/istoria-aimodosia-megaro.jpg';
import imgDotes from '../assets/images/istoria-aimodotes.jpg';
import imgBanner from '../assets/images/istoria-banner-apothaima.jpg';
const images = [
  { src: imgMegaro, position: '50% 62%', alt: 'Εθελοντική αιμοδοσία του ΑΠΟΘΑΙΜΑ στο φουαγιέ του Μεγάρου Μουσικής Αθηνών: εθελοντές δότες, γιατροί και νοσηλευτές ανάμεσα σε κόκκινα μπαλόνια' },
  { src: imgDotes, position: '50% 58%', alt: 'Εθελοντές δότες ξαπλωμένοι σε καρέκλες αιμοδοσίας δίνουν αίμα, ενώ νοσηλεύτριες με λευκές ποδιές τους φροντίζουν' },
  { src: imgBanner, position: '68% 50%', alt: 'Roll-up banner του ΑΠΟΘΑΙΜΑ COMMUNITY με το λογότυπο της σταγόνας-καρδιάς και το σύνθημα «κάνε καλό, νιώσε καλύτερα!»', variant: 'banner' },
];
const milestones = [
  { year: '2021', text: 'Η πρώτη διήμερη εθελοντική αιμοδοσία στο Μέγαρο Μουσικής Αθηνών.' },
  { year: '2022', text: 'Πρώτες συνεργασίες με τον ΠΑ.Σ.ΠΑ.Μ.Α. και το Εθνικό Κέντρο Αιμοδοσίας.' },
  { year: '2025', text: 'Πρώτη φορά ενημέρωση και εγγραφή εθελοντών δοτών μυελού των οστών.' },
  { year: '2026', text: '5 χρόνια ΑΠΟΘΑΙΜΑ και νέες δράσεις ως ΑΠΟΘΑΙΜΑ COMMUNITY ΑΜΚΕ.' },
];
---
<Base title="Η ιστορία μας" description="Πώς μια ιδέα προσφοράς το 2021 έγινε το ΑΠΟΘΑΙΜΑ COMMUNITY: εθελοντικές αιμοδοσίες, αλληλεγγύη και κοινότητα.">
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Η ιστορία μας</span>
      <h1>{istoria.subtitle}</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {istoria.sections.map((s, i) => (
        <>
          <div class="prose">
<figure class:list={['story-img', images[i].variant && `story-img--${images[i].variant}`]}>
  <Image
    src={images[i].src}
    alt={images[i].alt}
    widths={[640, 960, 1280, 1920]}
    sizes="(max-width: 1240px) calc(100vw - 48px), 1200px"
    style={`object-position: ${images[i].position}`}
    loading="lazy"
    decoding="async"
  />
</figure>            {s.paras.map((p) => <p>{p}</p>)}
          </div>
          {i < images.length && (
            <div class="story-img"><Image src={images[i]} alt="Στιγμιότυπο από δράση του ΑΠΟΘΑΙΜΑ" width={1200} loading="lazy" /></div>
          )}
        </>
      ))}
    </div>
  </section>
  <section class="section section--beige">
    <div class="container">
      <span class="eyebrow">Ορόσημα</span>
      <h2 class="h2" style="margin-top:10px">Η διαδρομή μας</h2>
      <ol class="timeline">
        {milestones.map((m) => <li><strong>{m.year}</strong>{m.text}</li>)}
      </ol>
    </div>
  </section>
</Base>
