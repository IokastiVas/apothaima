{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "shortTitle": {
      "type": "string"
    },
    "startDate": {
      "type": "string",
      "format": "date-time"
    },
    "endDate": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string"
    },
    "tag": {
      "type": "string",
      "enum": [
        "aimodosia",
        "allileggyi"
      ]
    },
    "location": {
      "type": "string"
    },
    "partners": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "gallery": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alt": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "startDate",
    "type",
    "tag",
    "location"
  ]
}